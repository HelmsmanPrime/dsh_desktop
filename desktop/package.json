{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness (dsh) 桌面端 —— 本地 dsh web 服务的 Electron 壳",
  "main": "main.js",
  "author": "HelmsmanPrime",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:backend": "node scripts/build-backend.mjs",
    "pack": "npm run build:backend && electron-builder --dir",
    "dist": "npm run build:backend && electron-builder --dir && node scripts/make-portable-sfx.mjs && node scripts/make-installer.mjs",
    "dist:win": "npm run build:backend && electron-builder --dir --win && node scripts/make-portable-sfx.mjs && node scripts/make-installer.mjs"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "rcedit": "^5.0.1"
  },
  "build": {
    "appId": "com.helmsman.dsh-desktop",
    "productName": "DSH Desktop",
    "copyright": "© 2026 HelmsmanPrime",
    "afterAllArtifactBuild": "scripts/patch-icons.mjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon-data.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/node.exe",
        "to": "runtime/node.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DSH Desktop"
    }
  }
}
